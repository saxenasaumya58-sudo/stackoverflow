# Replace EXAMPLE with values from your deployment provider before enabling features.
# NODE_ENV is managed by Next.js; do not define it in this file.

# Core application / database-backed features
MONGODB_URI=EXAMPLE
JWT_SECRET=EXAMPLE
DEMO_MODE=EXAMPLE
JWT_ISSUE_TIME_CHECK=EXAMPLE

# Session and device security (positive integer durations/count)
SESSION_INACTIVITY_MS=EXAMPLE
DEVICE_OTP_TTL_MS=EXAMPLE
DEVICE_CHALLENGE_TTL_MS=EXAMPLE
DEVICE_OTP_MAX_ATTEMPTS=EXAMPLE
TRUSTED_DEVICE_TTL_SECONDS=EXAMPLE
TRUSTED_PROXY_IP_HEADER=EXAMPLE

# Email delivery (SMTP_PASSWORD is preferred; SMTP_PASS is a supported alias)
SMTP_HOST=EXAMPLE
SMTP_PORT=EXAMPLE
SMTP_SECURE=EXAMPLE
SMTP_USER=EXAMPLE
SMTP_PASSWORD=EXAMPLE
SMTP_PASS=EXAMPLE
EMAIL_FROM=EXAMPLE
ALLOW_MOCK_DELIVERY=EXAMPLE

# SMS delivery
TWILIO_ACCOUNT_SID=EXAMPLE
TWILIO_AUTH_TOKEN=EXAMPLE
TWILIO_FROM_NUMBER=EXAMPLE

# Payments and scheduled jobs
RAZORPAY_KEY_ID=EXAMPLE
RAZORPAY_KEY_SECRET=EXAMPLE
RAZORPAY_WEBHOOK_SECRET=EXAMPLE
CRON_SECRET=EXAMPLE

# Image uploads
CLOUDINARY_CLOUD_NAME=EXAMPLE
CLOUDINARY_API_KEY=EXAMPLE
CLOUDINARY_API_SECRET=EXAMPLE
CLOUDINARY_UPLOAD_PRESET=EXAMPLE

# Optional build-time output directory; normally leave unset.
# NEXT_BUILD_DIST_DIR=EXAMPLE
